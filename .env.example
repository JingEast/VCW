# VCW Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.

# Flask
SECRET_KEY=your-production-secret-key-here
FLASK_DEBUG=false

# Database (default: SQLite; use PostgreSQL in production)
DATABASE_URL=sqlite:///data/vcw.db
# DATABASE_URL=postgresql://vcw:vcw@localhost:5432/vcw

# LLM API (override config.json values)
VCW_API_KEY=sk-your-openai-api-key-here
VCW_BASE_URL=https://api.openai.com/v1
VCW_MODEL=gpt-4o

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=db+postgresql+psycopg2://vcw:vcw@localhost:5432/vcw
